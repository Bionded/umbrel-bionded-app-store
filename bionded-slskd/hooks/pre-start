#!/usr/bin/env bash
set -euo pipefail

# Create this app's download folders as 1000:1000 so
# Docker never creates them root-owned. Existing folders are left untouched.
HOME_DIR="${UMBREL_ROOT}/home"
[[ -d "${HOME_DIR}" ]] || HOME_DIR="${UMBREL_ROOT}/data/storage"
DOWNLOADS="${HOME_DIR}/Downloads"
[[ -d "${DOWNLOADS}" ]] || DOWNLOADS="${UMBREL_ROOT}/data/storage/downloads"

for dir in "${DOWNLOADS}/slskd" "${DOWNLOADS}/slskd/complete" "${DOWNLOADS}/slskd/incomplete"; do
	if [[ ! -d "${dir}" ]]; then
		mkdir -p "${dir}"
		chown 1000:1000 "${dir}"
	fi
done
